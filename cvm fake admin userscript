// ==UserScript==
// @name         CollabVM UI Overlay (Smart Username)
// @namespace    http://tampermonkey.net/
// @version      2.5
// @description  CollabVM overlay with auto username detection + hotkey
// @match        *://computernewb.com/collab-vm/*
// @match        *://computernewb.com/~dark/cvm12-audio/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const STORAGE_KEY = "cvm_username";

    // -------------------------
    // GET USERNAME (smart priority chain)
    // -------------------------
    function resolveUsername(forcePrompt = false) {
        let name = null;

        // 1. Try DOM account name
        const domName = document.querySelector("#accountDropdownUsername");
        if (domName && domName.textContent.trim()) {
            name = domName.textContent.trim();
            console.log("[CVM] username from DOM:", name);
        }

        // 2. Try localStorage
        if (!name) {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored) {
                name = stored;
                console.log("[CVM] username from storage:", name);
            }
        }

        // 3. Prompt fallback
        if (!name || forcePrompt) {
            name = prompt("Enter your CollabVM username:");
            if (!name) name = "user";

            console.log("[CVM] username from prompt:", name);
        }

        localStorage.setItem(STORAGE_KEY, name);

        return name + "▸";
    }

    let TARGET_NAME = null;

    function initUsername() {
        TARGET_NAME = resolveUsername();
        console.log("[CVM] active username:", TARGET_NAME);
    }

    // -------------------------
    // HOTKEY (Ctrl+Shift+U)
    // -------------------------
    document.addEventListener("keydown", (e) => {
        if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === "u") {
            e.preventDefault();

            TARGET_NAME = resolveUsername(true);

            console.log("[CVM] username updated via hotkey");
        }
    });

    const $ = (q, r = document) => r.querySelector(q);
    const $$ = (q, r = document) => [...r.querySelectorAll(q)];

    function forceVisible(el, mode = "block") {
        if (!el) return;
        el.style.setProperty("display", mode, "important");
        el.hidden = false;
    }

    // -------------------------
    // PATCH USERS
    // -------------------------
    function patchUsers() {
        $$(".username-registered").forEach(el => {
            el.classList.replace("username-registered", "username-admin");
        });

        const current = $("#userlist > tr.user-registered.user-current");
        if (current) {
            current.classList.replace("user-registered", "user-admin");
        }
    }

    // -------------------------
    // PATCH STAFF UI
    // -------------------------
    function patchStaff() {
        const staff = $("#staffbtns");

        if (staff) {
            forceVisible(staff, "block");

            $$("button", staff).forEach(btn => {
                forceVisible(btn, "inline-block");
                btn.disabled = false;
            });
        }

        const xss = $("#xssCheckboxContainer");
        if (xss) forceVisible(xss, "block");
    }

    // -------------------------
    // PATCH CHAT
    // -------------------------
    function patchChat(root = document) {
        if (!TARGET_NAME) return;

        $$(".chat-username-registered", root).forEach(el => {
            if (el.textContent.trim() === TARGET_NAME) {
                el.classList.replace(
                    "chat-username-registered",
                    "chat-username-admin"
                );
            }
        });
    }

    // -------------------------
    // INIT
    // -------------------------
    function init() {
        initUsername();

        patchUsers();
        patchStaff();
        patchChat();

        const observer = new MutationObserver(mutations => {
            for (const m of mutations) {
                m.addedNodes.forEach(node => {
                    if (node.nodeType === 1) patchChat(node);
                });
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        setInterval(() => {
            patchUsers();
            patchStaff();
            patchChat();
        }, 1000);

        console.log("[CVM] overlay active");
    }

    const wait = setInterval(() => {
        if ($("#chatList") || $("#userlist") || $("#staffbtns")) {
            clearInterval(wait);
            init();
        }
    }, 300);

})();
